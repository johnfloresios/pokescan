# pokeScan environment variables
# Copy this file to .env and configure ONE of the options below.

# Recommended for production and App Store builds.
# Your server proxy stores the private PokéWallet key and forwards requests.
EXPO_PUBLIC_POKEWALLET_PROXY_URL=

# Local development only. EXPO_PUBLIC values are embedded in the app.
EXPO_PUBLIC_POKEWALLET_API_KEY=pk_test_replace_with_your_key

# Supabase development project. Find these under Project Settings → API.
# The publishable/anon key is designed for client use; protect data with RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_or_anon_key
