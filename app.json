{
  "expo": {
    "name": "pokeScan",
    "slug": "pokescan",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pokescan",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokescan.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "pokeScan uses the camera to identify your Pokémon cards."
      }
    },
    "android": {
      "package": "com.pokescan.scanner",
      "permissions": ["CAMERA"]
    },
    "plugins": ["expo-router", ["expo-camera", { "cameraPermission": "Allow pokeScan to scan Pokémon cards." }]],
    "autolinking": { "nativeModulesDir": "./modules" },
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "pokewalletProxyUrl": "",
      "pokewalletApiKey": ""
    }
  }
}
