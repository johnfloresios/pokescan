{
  "expo": {
    "name": "NicePull",
    "slug": "nicepull",
    "description": "Know what you've pulled.",
    "version": "1.0.0",
    "icon": "./assets/nicepull-icon.png",
    "orientation": "portrait",
    "scheme": "nicepull",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokescan.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "NicePull uses the camera to identify your Pokémon cards."
      }
    },
    "android": {
      "package": "com.pokescan.scanner",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": ["expo-router"],
    "autolinking": { "nativeModulesDir": "./modules" },
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "pokewalletProxyUrl": "",
      "pokewalletApiKey": ""
    }
  }
}
